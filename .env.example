# App traffic: Neon pooled URL (hostname contains -pooler).
# Use connect_timeout so cold starts on Vercel/Neon do not fail at the default 5s.
# Do not use channel_binding=require on Vercel — it can break some TLS clients.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Optional: Neon direct URL (no -pooler) for local prisma migrate / db push
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Local:
AUTH_URL="http://localhost:3000"
# Production (Vercel): https://demo.haramtravel.uk

STORAGE_PROVIDER="local"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me-after-first-login"
